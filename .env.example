# Aventra Billing — environment configuration.
# Copy to `.env` and fill in real values. Never commit `.env`.
#
# Local development uses the existing machine PostgreSQL server
# (default port 5432). Point DATABASE_URL at the project database.

# PostgreSQL connection string for the Aventra development database.
# Example shape only — fill in real values locally, never commit them.
DATABASE_URL=

# Base URL of the running application (used for auth callbacks/links).
BETTER_AUTH_URL=http://localhost:3000

# High-entropy secret for Better Auth (minimum 32 characters).
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Resend API key for authentication email delivery.
RESEND_API_KEY=

# Verified sender used for auth emails, e.g. "Aventra <auth@example.com>".
AUTH_EMAIL_FROM=

# Shared bearer secret protecting the recurring-billing scheduler endpoint
# (POST /api/cron/recurring-invoices). Required ONLY where scheduled
# execution is deployed; local development and unit tests do not need it.
# Minimum 32 characters. Generate with: openssl rand -base64 32
CRON_SECRET=
