  @@unique([organizationId, returnNumber])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, returnDate])
  @@index([customerId])
  @@index([invoiceId])
  @@index([salesOrderId])
  @@map("sales_return")
