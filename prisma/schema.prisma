// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String       @id
  name          String
  email         String
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  role          String?
  banned        Boolean?     @default(false)
  banReason     String?
  banExpires    DateTime?
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]

  @@unique([email])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?
  impersonatedBy       String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id          String       @id
  name        String
  slug        String
  logo        String?
  createdAt   DateTime
  metadata    String?
  members     Member[]
  invitations Invitation[]
  profile     OrganizationProfile?
  address     OrganizationAddress?
  taxProfile  OrganizationTaxProfile?
  onboarding  OrganizationOnboarding?
  customers       Customer[]
  suppliers       Supplier[]
  products        Product[]
  categories      Category[]
  unitsOfMeasurement UnitOfMeasurement[]
  billingSettings BillingSettings[]
  invoices        Invoice[]
  creditNotes     CreditNote[]
  debitNotes      DebitNote[]
  recurringSchedules RecurringSchedule[]
  recurringOccurrences RecurringOccurrence[]
  payments        Payment[]
  paymentAllocations PaymentAllocation[]
  estimates       Estimate[]
  salesOrders     SalesOrder[]
  salesSettings   SalesSettings?
  purchaseOrders  PurchaseOrder[]
  purchaseBills   PurchaseBill[]
  purchaseReturns PurchaseReturn[]
  supplierPayments SupplierPayment[]
  supplierPaymentAllocations SupplierPaymentAllocation[]
  purchaseSettings PurchaseSettings?
  deliveryChallans DeliveryChallan[]
  salesReturns     SalesReturn[]
  salesOpportunities SalesOpportunity[]

  @@unique([slug])
  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

enum OnboardingStatus {
  IN_PROGRESS
  COMPLETED
}

enum SubscriptionPlan {
  STARTER
  BUSINESS
  ENTERPRISE
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

model OrganizationProfile {
  organizationId String       @id
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  legalName      String
  displayName    String
  businessEmail  String
  phone          String
  industry       String
  companySize    String
  website        String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("organization_profile")
}

model OrganizationAddress {
  organizationId String       @id
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  country        String
  state          String
  city           String
  postalCode     String
  addressLine    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("organization_address")
}

model OrganizationTaxProfile {
  organizationId         String       @id
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  gstNumber              String
  panNumber              String
  registeredBusinessName String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  @@map("organization_tax_profile")
}

model OrganizationOnboarding {
  organizationId String             @id
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  status         OnboardingStatus   @default(IN_PROGRESS)
  currentStep    Int                @default(0)
  plan           SubscriptionPlan?
  billingCycle   BillingCycle?
  completedAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@map("organization_onboarding")
}

enum CustomerType {
  BUSINESS
  INDIVIDUAL
}

enum GstTreatment {
  REGISTERED_BUSINESS_REGULAR
  CONSUMER_UNREGISTERED
  OVERSEAS_EXPORT
  SPECIAL_ECONOMIC_ZONE
  DEEMED_EXPORT
  COMPOSITION_SCHEME
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

model Customer {
  id                   String         @id
  organizationId       String
  organization         Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Identity
  name                 String
  customerType         CustomerType   @default(BUSINESS)
  gstTreatment         GstTreatment   @default(REGISTERED_BUSINESS_REGULAR)
  status               CustomerStatus @default(ACTIVE)

  // Contact Information
  contactPerson        String?
  email                String?
  phone                String?
  alternatePhone       String?

  // Billing Address
  billingAddressLine1  String?
  billingAddressLine2  String?
  billingCity          String?
  billingState         String?
  billingPinCode       String?
  billingCountry       String         @default("India")

  // Shipping Address
  sameAsBillingAddress Boolean        @default(true)
  shippingAddressLine1 String?
  shippingAddressLine2 String?
  shippingCity         String?
  shippingState        String?
  shippingPinCode      String?
  shippingCountry      String?        @default("India")

  // Tax & Compliance
  gstin                String?
  pan                  String?
  currency             String         @default("INR (₹)")
  placeOfSupply        String         @default("27-Maharashtra")

  // Additional Settings
  paymentTerms         String         @default("Net 15 days")
  creditLimit          Decimal?       @db.Decimal(14, 2)
  defaultDiscount      Decimal?       @db.Decimal(5, 2)
  defaultTaxPreference String         @default("18% (IGST)")
  priceList            String         @default("Default Price List")

  // Notes & Tags
  internalNotes        String?
  tags                 String[]       @default([])

  // Timestamps
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  invoices             Invoice[]
  creditNotes          CreditNote[]
  debitNotes           DebitNote[]
  recurringSchedules   RecurringSchedule[]
  payments             Payment[]
  estimates            Estimate[]
  salesOrders          SalesOrder[]
  deliveryChallans     DeliveryChallan[]
  salesReturns         SalesReturn[]
  salesOpportunities   SalesOpportunity[]

  @@index([organizationId])
  @@index([organizationId, name])
  @@index([organizationId, email])
  @@index([organizationId, status])
  @@map("customer")
}

model Supplier {
  id             String @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Identity
  name   String
  status SupplierStatus @default(ACTIVE)

  // Contact Information
  contactPerson  String?
  email          String?
  phone          String?
  alternatePhone String?

  // Billing Address
  billingAddressLine1 String?
  billingAddressLine2 String?
  billingCity         String?
  billingState        String?
  billingPinCode      String?
  billingCountry      String  @default("India")

  // Shipping / Dispatch Address
  sameAsBillingAddress Boolean @default(true)
  shippingAddressLine1 String?
  shippingAddressLine2 String?
  shippingCity         String?
  shippingState        String?
  shippingPinCode      String?
  shippingCountry      String? @default("India")

  // Tax & Compliance
  gstTreatment GstTreatment @default(REGISTERED_BUSINESS_REGULAR)
  gstin        String?
  pan          String?
  currency     String       @default("INR (₹)")

  // Commercial Terms
  paymentTerms String?

  // Notes
  internalNotes String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseOrders PurchaseOrder[]
  purchaseBills  PurchaseBill[]
  purchaseReturns PurchaseReturn[]
  supplierPayments SupplierPayment[]

  // A GSTIN identifies exactly one registered entity, so it is unique per
  // organization when present. PostgreSQL treats NULLs as distinct, leaving
  // unregistered suppliers unconstrained.
  @@unique([organizationId, gstin])
  @@index([organizationId])
  @@index([organizationId, name])
  @@index([organizationId, status])
  @@map("supplier")
}

enum ProductType {
  PRODUCT
  SERVICE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

model Product {
  id             String        @id
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Basic Information
  name           String
  type           ProductType   @default(PRODUCT)
  sku            String?
  category       String?
  status         ProductStatus @default(ACTIVE)
  description    String?

  // Pricing
  sellingPrice   Decimal       @default(0) @db.Decimal(14, 2)
  purchasePrice  Decimal?      @db.Decimal(14, 2)
  currency       String        @default("INR (₹)")
  unit           String        @default("PCS")

  // Tax & Compliance
  hsnSac         String?
  taxRate        Decimal       @default(18) @db.Decimal(5, 2)
  taxPreference  String        @default("Taxable")

  // Inventory Settings (Products only)
  trackInventory Boolean       @default(false)
  reorderPoint   Decimal?      @db.Decimal(14, 2)

  // Notes
  internalNotes  String?

  // Timestamps
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  invoiceItems    InvoiceItem[]
  creditNoteItems CreditNoteItem[]
  debitNoteItems  DebitNoteItem[]
  recurringScheduleItems RecurringScheduleItem[]
  estimateItems   EstimateItem[]
  salesOrderItems SalesOrderItem[]
  purchaseOrderItems PurchaseOrderItem[]
  purchaseBillItems  PurchaseBillItem[]
  purchaseReturnItems PurchaseReturnItem[]
  deliveryChallanItems DeliveryChallanItem[]
  salesReturnItems     SalesReturnItem[]

  @@index([organizationId])
  @@index([organizationId, type])
  @@index([organizationId, status])
  @@index([organizationId, name])
  @@index([organizationId, sku])
  @@map("product")
}

enum BillingDocumentType {
  INVOICE
  DEBIT_NOTE
  CREDIT_NOTE
  RECURRING_INVOICE
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

/// Organization-scoped product/service category master. `Product.category`
/// stores the category name as its canonical key; mutations validate it
/// against active records here (see categories feature).
model Category {
  id             String         @id
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name           String
  description    String?
  status         CategoryStatus @default(ACTIVE)

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([organizationId, status])
  @@map("category")
}

enum UnitStatus {
  ACTIVE
  INACTIVE
}

/// Organization-scoped unit-of-measurement master. `Product.unit` stores the
/// unit code as its canonical key; mutations validate it against active
/// records here (see units-of-measurement feature). `precision` is the
/// maximum allowed decimal places for quantities measured in this unit and
/// never exceeds the Decimal(12,3) line-quantity scale.
model UnitOfMeasurement {
  id             String     @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name           String
  code           String
  description    String?
  precision      Int        @default(3)
  status         UnitStatus @default(ACTIVE)

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([organizationId, status])
  @@map("unit_of_measurement")
}

enum HsnSacType {
  HSN
  SAC
}

/// Global GST classification reference imported from the supplied
/// `HSN_SAC.xlsx` workbook (see hsn-sac-mapping feature). Shared across
/// organizations and never duplicated per organization. `Product.hsnSac`
/// stores the code string; mutations validate it against active records
/// here. Tax rates stay in product/tax configuration — never inferred here.
model HsnSacCode {
  id          String     @id
  type        HsnSacType
  code        String
  description String
  isActive    Boolean    @default(true)

  // Data provenance (workbook source, never an official revision claim)
  sourceFile  String?
  sourceSheet String?
  importedAt  DateTime   @default(now())

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([type, code])
  @@index([type])
  @@index([code])
  @@map("hsn_sac_code")
}

model BillingSettings {
  id             String              @id
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documentType   BillingDocumentType

  // Numbering configuration
  prefix         String              @default("INV-")
  suffix         String?
  nextNumber     Int                 @default(1)
  padding        Int                 @default(4)

  // Defaults
  defaultNotes   String?
  defaultTerms   String?

  // Timestamps
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([organizationId, documentType])
  @@index([organizationId])
  @@index([organizationId, documentType])
  @@map("billing_settings")
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

model Invoice {
  id                      String        @id
  organizationId          String
  organization            Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceNumber           String

  // Customer reference & snapshots
  customerId              String?
  customer                Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName            String
  customerEmail           String?
  customerAddress         String?
  customerGstin           String?
  customerPlaceOfSupply   String?

  // Dates & Terms
  issueDate               DateTime
  dueDate                 DateTime
  paymentTerms            String        @default("Net 15 days")
  status                  InvoiceStatus @default(DRAFT)
  taxMode                 String        @default("CGST_SGST")
  currency                String        @default("INR (₹)")

  // Monetary Totals (decimal-safe)
  subtotal                Decimal       @db.Decimal(14, 2)
  lineDiscountTotal       Decimal       @default(0) @db.Decimal(14, 2)
  additionalDiscount      Decimal       @default(0) @db.Decimal(14, 2)
  additionalDiscountType  String        @default("fixed")
  additionalDiscountLabel String?
  additionalCharges       Decimal       @default(0) @db.Decimal(14, 2)
  additionalChargesLabel  String?
  taxableAmount           Decimal       @db.Decimal(14, 2)
  cgst                    Decimal       @default(0) @db.Decimal(14, 2)
  sgst                    Decimal       @default(0) @db.Decimal(14, 2)
  igst                    Decimal       @default(0) @db.Decimal(14, 2)
  totalTax                Decimal       @default(0) @db.Decimal(14, 2)
  total                   Decimal       @db.Decimal(14, 2)
  amountPaid              Decimal       @default(0) @db.Decimal(14, 2)

  // Recurring generation linkage (nullable; ordinary invoices leave these null)
  recurringScheduleId     String?
  recurringPeriod         String?

  // Notes & Terms
  notes                   String?
  terms                   String?

  // Timestamps
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  // Line Items
  items                   InvoiceItem[]
  creditNotes             CreditNote[]
  debitNotes              DebitNote[]
  recurringOccurrences    RecurringOccurrence[]
  paymentAllocations      PaymentAllocation[]
  convertedFromEstimate   Estimate?             @relation("EstimateToInvoice")
  salesOrderId            String?
  salesOrder              SalesOrder?           @relation("SalesOrderToInvoices", fields: [salesOrderId], references: [id], onDelete: SetNull)
  deliveryChallans        DeliveryChallan[]
  salesReturns            SalesReturn[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, issueDate])
  @@index([customerId])
  @@index([salesOrderId])
  @@index([recurringScheduleId, recurringPeriod])
  @@map("invoice")
}

model InvoiceItem {
  id            String   @id
  invoiceId     String
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  productId     String?
  product       Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  item          String
  description   String?
  hsnSac        String?
  // Unit snapshot from the product master at selection time.
  unit          String?
  quantity      Decimal  @db.Decimal(12, 3)
  unitPrice     Decimal  @db.Decimal(14, 2)
  discount      Decimal  @default(0) @db.Decimal(5, 2)
  taxRate       Decimal  @default(18) @db.Decimal(5, 2)
  taxableAmount Decimal  @db.Decimal(14, 2)
  taxAmount     Decimal  @db.Decimal(14, 2)
  lineTotal     Decimal  @db.Decimal(14, 2)
  sortOrder     Int      @default(0)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  salesReturnItems SalesReturnItem[]

  @@index([invoiceId])
  @@index([productId])
  @@map("invoice_item")
}

enum CreditNoteStatus {
  DRAFT
  ISSUED
  CANCELLED
}

enum DebitNoteStatus {
  DRAFT
  ISSUED
  CANCELLED
}

model CreditNote {
  id                    String           @id
  organizationId        String
  organization          Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creditNoteNumber      String

  // Original Invoice reference
  invoiceId             String
  invoice               Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  // Customer reference & snapshots
  customerId            String?
  customer              Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName          String
  customerEmail         String?
  customerAddress       String?
  customerGstin         String?
  customerPlaceOfSupply String?

  // Dates & Reason
  issueDate             DateTime
  status                CreditNoteStatus @default(DRAFT)
  reason                String
  taxMode               String           @default("CGST_SGST")
  currency              String           @default("INR (₹)")

  // Monetary Totals (decimal-safe)
  subtotal              Decimal          @db.Decimal(14, 2)
  lineDiscountTotal     Decimal          @default(0) @db.Decimal(14, 2)
  taxableAmount         Decimal          @db.Decimal(14, 2)
  cgst                  Decimal          @default(0) @db.Decimal(14, 2)
  sgst                  Decimal          @default(0) @db.Decimal(14, 2)
  igst                  Decimal          @default(0) @db.Decimal(14, 2)
  totalTax              Decimal          @default(0) @db.Decimal(14, 2)
  total                 Decimal          @db.Decimal(14, 2)

  // Notes & Terms
  notes                 String?
  terms                 String?

  // Timestamps
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  // Line Items
  items                 CreditNoteItem[]
  salesReturns          SalesReturn[]

  @@unique([organizationId, creditNoteNumber])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, issueDate])
  @@index([invoiceId])
  @@index([customerId])
  @@map("credit_note")
}

model CreditNoteItem {
  id            String     @id
  creditNoteId  String
  creditNote    CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)

  invoiceItemId String?
  productId     String?
  product       Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)

  item          String
  description   String?
  hsnSac        String?
  quantity      Decimal    @db.Decimal(12, 3)
  unitPrice     Decimal    @db.Decimal(14, 2)
  discount      Decimal    @default(0) @db.Decimal(5, 2)
  taxRate       Decimal    @default(18) @db.Decimal(5, 2)
  taxableAmount Decimal    @db.Decimal(14, 2)
  taxAmount     Decimal    @db.Decimal(14, 2)
  lineTotal     Decimal    @db.Decimal(14, 2)
  sortOrder     Int        @default(0)

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([creditNoteId])
  @@index([productId])
  @@index([invoiceItemId])
  @@map("credit_note_item")
}

model DebitNote {
  id                    String          @id
  organizationId        String
  organization          Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  debitNoteNumber       String

  // Original Invoice reference
  invoiceId             String
  invoice               Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  // Customer reference & snapshots
  customerId            String?
  customer              Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName          String
  customerEmail         String?
  customerAddress       String?
  customerGstin         String?
  customerPlaceOfSupply String?

  // Dates & Reason
  issueDate             DateTime
  status                DebitNoteStatus @default(DRAFT)
  reason                String
  taxMode               String          @default("CGST_SGST")
  currency              String          @default("INR (₹)")

  // Monetary Totals (decimal-safe)
  subtotal              Decimal         @db.Decimal(14, 2)
  lineDiscountTotal     Decimal         @default(0) @db.Decimal(14, 2)
  taxableAmount         Decimal         @db.Decimal(14, 2)
  cgst                  Decimal         @default(0) @db.Decimal(14, 2)
  sgst                  Decimal         @default(0) @db.Decimal(14, 2)
  igst                  Decimal         @default(0) @db.Decimal(14, 2)
  totalTax              Decimal         @default(0) @db.Decimal(14, 2)
  total                 Decimal         @db.Decimal(14, 2)

  // Notes & Terms
  notes                 String?
  terms                 String?

  // Timestamps
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  // Line Items
  items                 DebitNoteItem[]

  @@unique([organizationId, debitNoteNumber])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, issueDate])
  @@index([invoiceId])
  @@index([customerId])
  @@map("debit_note")
}

model DebitNoteItem {
  id            String    @id
  debitNoteId   String
  debitNote     DebitNote @relation(fields: [debitNoteId], references: [id], onDelete: Cascade)

  invoiceItemId String?
  productId     String?
  product       Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  item          String
  description   String?
  hsnSac        String?
  quantity      Decimal   @db.Decimal(12, 3)
  unitPrice     Decimal   @db.Decimal(14, 2)
  discount      Decimal   @default(0) @db.Decimal(5, 2)
  taxRate       Decimal   @default(18) @db.Decimal(5, 2)
  taxableAmount Decimal   @db.Decimal(14, 2)
  taxAmount     Decimal   @db.Decimal(14, 2)
  lineTotal     Decimal   @db.Decimal(14, 2)
  sortOrder     Int       @default(0)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([debitNoteId])
  @@index([productId])
  @@index([invoiceItemId])
  @@map("debit_note_item")
}

enum RecurringFrequency {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum RecurringScheduleStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum RecurringOccurrenceStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

model RecurringSchedule {
  id                String                  @id
  organizationId    String
  organization      Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name              String

  // Customer reference & snapshot (snapshot survives customer edits/deletion)
  customerId        String?
  customer          Customer?               @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName      String
  customerEmail     String?
  customerAddress   String?
  customerGstin     String?
  customerPlaceOfSupply String?

  // Recurrence policy
  frequency         RecurringFrequency
  startDate         DateTime
  endDate           DateTime?
  nextRunDate       DateTime
  timezone          String                  @default("Asia/Kolkata")
  status            RecurringScheduleStatus @default(ACTIVE)

  // Invoice template (frozen snapshots; future generations only)
  paymentTerms      String                  @default("Net 15 days")
  additionalCharges Decimal                 @default(0) @db.Decimal(14, 2)
  additionalChargesLabel String?
  additionalDiscount Decimal                @default(0) @db.Decimal(14, 2)
  additionalDiscountType String              @default("fixed")
  additionalDiscountLabel String?
  notes             String?
  terms             String?

  // Operational counters
  successCount        Int      @default(0)
  failureCount        Int      @default(0)
  consecutiveFailures Int      @default(0)
  lastRunAt           DateTime?
  lastResult          String?

  // Audit
  createdBy         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  items             RecurringScheduleItem[]
  occurrences       RecurringOccurrence[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, status, nextRunDate])
  @@index([customerId])
  @@map("recurring_schedule")
}

model RecurringScheduleItem {
  id            String            @id
  scheduleId    String
  schedule      RecurringSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  productId     String?
  product       Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)

  item          String
  description   String?
  hsnSac        String?
  quantity      Decimal           @db.Decimal(12, 3)
  unitPrice     Decimal           @db.Decimal(14, 2)
  discount      Decimal           @default(0) @db.Decimal(5, 2)
  taxRate       Decimal           @default(18) @db.Decimal(5, 2)
  sortOrder     Int               @default(0)

  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([scheduleId])
  @@index([productId])
  @@map("recurring_schedule_item")
}

model RecurringOccurrence {
  id             String                     @id
  organizationId String
  organization   Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scheduleId     String
  schedule       RecurringSchedule          @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  // Immutable identity: schedule + intended billing period (YYYY-MM-DD)
  periodKey      String
  status         RecurringOccurrenceStatus  @default(PENDING)
  attempts       Int                        @default(0)
  claimedAt      DateTime?
  claimedBy      String?

  // Generation outcome
  invoiceId      String?
  invoice        Invoice?                   @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  error          String?

  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  @@unique([scheduleId, periodKey])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([scheduleId])
  @@index([invoiceId])
  @@map("recurring_occurrence")
}

enum PaymentStatus {
  ACTIVE
  REVERSED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  UPI
  CHEQUE
  CARD
  OTHER
}

model Payment {
  id             String        @id
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Customer reference & snapshot (snapshot survives customer edits/deletion)
  customerId     String?
  customer       Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName   String

  // Received amount (must equal the sum of allocations; overpayment rejected)
  amount         Decimal       @db.Decimal(14, 2)
  currency       String        @default("INR (₹)")
  paymentDate    DateTime
  method         PaymentMethod @default(OTHER)
  reference      String?
  notes          String?

  // Lifecycle: reversal is a state transition, never a delete
  status         PaymentStatus @default(ACTIVE)
  reversedAt     DateTime?
  reversalReason String?
  reversedBy     String?

  // Duplicate-submission protection (one form session = one key)
  idempotencyKey String?

  // Audit
  createdBy      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  allocations    PaymentAllocation[]

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, paymentDate])
  @@index([customerId])
  @@map("payment")
}

model PaymentAllocation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  paymentId      String
  payment        Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId      String
  invoice        Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  // Cash applied to this invoice (immutable once created)
  amount         Decimal      @db.Decimal(14, 2)

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([paymentId, invoiceId])
  @@index([organizationId])
  @@index([paymentId])
  @@index([invoiceId])
  @@map("payment_allocation")
}

enum EstimateStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
  CANCELLED
}

model Estimate {
  id                      String         @id
  organizationId          String
  organization            Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  estimateNumber          String

  // Customer reference & snapshots
  customerId              String?
  customer                Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName            String
  customerEmail           String?
  customerAddress         String?
  customerGstin           String?
  customerPlaceOfSupply   String?

  // Dates & Reference
  issueDate               DateTime
  validUntil              DateTime
  referenceNumber         String?
  status                  EstimateStatus @default(DRAFT)
  taxMode                 String         @default("CGST_SGST")
  currency                String         @default("INR (₹)")

  // Monetary Totals (decimal-safe)
  subtotal                Decimal        @db.Decimal(14, 2)
  lineDiscountTotal       Decimal        @default(0) @db.Decimal(14, 2)
  additionalDiscount      Decimal        @default(0) @db.Decimal(14, 2)
  additionalDiscountType  String         @default("fixed")
  additionalDiscountLabel String?
  additionalCharges       Decimal        @default(0) @db.Decimal(14, 2)
  additionalChargesLabel  String?
  taxableAmount           Decimal        @db.Decimal(14, 2)
  cgst                    Decimal        @default(0) @db.Decimal(14, 2)
  sgst                    Decimal        @default(0) @db.Decimal(14, 2)
  igst                    Decimal        @default(0) @db.Decimal(14, 2)
  totalTax                Decimal        @default(0) @db.Decimal(14, 2)
  total                   Decimal        @db.Decimal(14, 2)

  // Notes & Terms
  notes                   String?
  terms                   String?

  // Conversion to Invoice & Sales Order
  convertedToInvoiceId    String?        @unique
  convertedToInvoice      Invoice?       @relation("EstimateToInvoice", fields: [convertedToInvoiceId], references: [id], onDelete: SetNull)
  convertedToSalesOrderId String?        @unique
  convertedToSalesOrder   SalesOrder?    @relation("EstimateToSalesOrder", fields: [convertedToSalesOrderId], references: [id], onDelete: SetNull)
  convertedAt             DateTime?

  // Timestamps
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  // Line Items
  items                   EstimateItem[]
  salesOpportunities      SalesOpportunity[]

  @@unique([organizationId, estimateNumber])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, issueDate])
  @@index([customerId])
  @@map("estimate")
}

model EstimateItem {
  id            String       @id
  estimateId    String
  estimate      Estimate     @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  productId     String?
  product       Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)

  item          String
  description   String?
  hsnSac        String?
  // Unit snapshot from the product master at selection time.
  unit          String?
  quantity      Decimal      @db.Decimal(12, 3)
  unitPrice     Decimal      @db.Decimal(14, 2)
  discount      Decimal      @default(0) @db.Decimal(5, 2)
  taxRate       Decimal      @default(18) @db.Decimal(5, 2)
  taxableAmount Decimal      @db.Decimal(14, 2)
  taxAmount     Decimal      @db.Decimal(14, 2)
  lineTotal     Decimal      @db.Decimal(14, 2)
  sortOrder     Int          @default(0)

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([estimateId])
  @@index([productId])
  @@map("estimate_item")
}

model SalesSettings {
  id                  String       @id
  organizationId      String       @unique
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Estimate numbering
  estimatePrefix          String       @default("EST-")
  estimateSuffix          String?
  estimateNextNumber      Int          @default(1)
  estimatePadding         Int          @default(4)

  // Sales Order numbering
  salesOrderPrefix        String       @default("SO-")
  salesOrderSuffix        String?
  salesOrderNextNumber    Int          @default(1)
  salesOrderPadding       Int          @default(4)

  // Delivery Challan numbering
  deliveryChallanPrefix     String       @default("DC-")
  deliveryChallanSuffix     String?
  deliveryChallanNextNumber Int          @default(1)
  deliveryChallanPadding    Int          @default(4)

  // Sales Return numbering
  salesReturnPrefix         String       @default("SR-")
  salesReturnSuffix         String?
  salesReturnNextNumber     Int          @default(1)
  salesReturnPadding        Int          @default(4)

  // Defaults
  defaultValidityDays          Int          @default(30)
  defaultDeliveryDays          Int          @default(15)
  defaultNotes                 String?
  defaultTerms                 String?
  defaultSalesOrderNotes       String?
  defaultSalesOrderTerms       String?
  defaultDeliveryInstructions  String?
  defaultDeliveryTerms         String?
  defaultReturnReason          String?
  defaultReturnPolicy          String?

  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  @@index([organizationId])
  @@map("sales_settings")
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
}

model SalesOrder {
  id                      String           @id
  organizationId          String
  organization            Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orderNumber             String

  // Customer reference & snapshots
  customerId              String?
  customer                Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName            String
  customerEmail           String?
  customerAddress         String?
  customerGstin           String?
  customerPlaceOfSupply   String?

  // Dates & Reference
  orderDate               DateTime
  expectedDeliveryDate    DateTime?
  referenceNumber         String?          // Customer PO / Reference number
  status                  SalesOrderStatus @default(DRAFT)
  taxMode                 String           @default("CGST_SGST")
  currency                String           @default("INR (₹)")

  // Monetary Totals (decimal-safe)
  subtotal                Decimal          @db.Decimal(14, 2)
  lineDiscountTotal       Decimal          @default(0) @db.Decimal(14, 2)
  additionalDiscount      Decimal          @default(0) @db.Decimal(14, 2)
  additionalDiscountType  String           @default("fixed")
  additionalDiscountLabel String?
  additionalCharges       Decimal          @default(0) @db.Decimal(14, 2)
  additionalChargesLabel  String?
  taxableAmount           Decimal          @db.Decimal(14, 2)
  cgst                    Decimal          @default(0) @db.Decimal(14, 2)
  sgst                    Decimal          @default(0) @db.Decimal(14, 2)
  igst                    Decimal          @default(0) @db.Decimal(14, 2)
  totalTax                Decimal          @default(0) @db.Decimal(14, 2)
  total                   Decimal          @db.Decimal(14, 2)

  // Notes & Terms
  notes                   String?
  terms                   String?

  // Source Estimate / Quotation (if converted from quotation)
  sourceEstimate          Estimate?        @relation("EstimateToSalesOrder")

  // Invoices generated from this sales order
  invoices                Invoice[]        @relation("SalesOrderToInvoices")
  deliveryChallans        DeliveryChallan[]
  salesReturns            SalesReturn[]
  salesOpportunities      SalesOpportunity[]

  // Timestamps
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  // Line Items
  items                   SalesOrderItem[]

  @@unique([organizationId, orderNumber])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, orderDate])
  @@index([customerId])
  @@map("sales_order")
}

model SalesOrderItem {
  id                String     @id
  salesOrderId      String
  salesOrder        SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  productId         String?
  product           Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)

  item              String
  description       String?
  hsnSac            String?
  // Unit snapshot from the product master at selection time.
  unit              String?
  quantity          Decimal    @db.Decimal(12, 3)
  fulfilledQuantity Decimal    @default(0) @db.Decimal(12, 3)
  unitPrice         Decimal    @db.Decimal(14, 2)
  discount          Decimal    @default(0) @db.Decimal(5, 2)
  taxRate           Decimal    @default(18) @db.Decimal(5, 2)
  taxableAmount     Decimal    @db.Decimal(14, 2)
  taxAmount         Decimal    @db.Decimal(14, 2)
  lineTotal         Decimal    @db.Decimal(14, 2)
  sortOrder         Int        @default(0)

  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  deliveryChallanItems DeliveryChallanItem[]

  @@index([salesOrderId])
  @@index([productId])
  @@map("sales_order_item")
}

enum DeliveryChallanStatus {
  DRAFT
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum SalesReturnStatus {
  DRAFT
  APPROVED
  COMPLETED
  CANCELLED
}

enum OpportunityStage {
  NEW_LEAD
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

model DeliveryChallan {
  id                    String                @id
  organizationId        String
  organization          Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  challanNumber         String

  customerId            String?
  customer              Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName          String
  customerEmail         String?
  customerAddress       String?
  customerGstin         String?

  salesOrderId          String?
  salesOrder            SalesOrder?           @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)

  invoiceId             String?
  invoice               Invoice?              @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  challanDate           DateTime
  dispatchDate          DateTime?
  deliveryDate          DateTime?
  status                DeliveryChallanStatus @default(DRAFT)

  deliveryAddress       String?
  transporterName       String?
  vehicleNumber         String?
  trackingNumber        String?
  transportMode         String?
  deliveryReason        String                @default("Supply against Sales Order")
  recipientName         String?
  recipientPhone        String?
  notes                 String?
  terms                 String?

  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  items                 DeliveryChallanItem[]

  @@unique([organizationId, challanNumber])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, challanDate])
  @@index([customerId])
  @@index([salesOrderId])
  @@map("delivery_challan")
}

model DeliveryChallanItem {
  id                String          @id
  challanId         String
  challan           DeliveryChallan @relation(fields: [challanId], references: [id], onDelete: Cascade)

  salesOrderItemId  String?
  salesOrderItem    SalesOrderItem? @relation(fields: [salesOrderItemId], references: [id], onDelete: SetNull)

  productId         String?
  product           Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)

  item              String
  description       String?
  hsnSac            String?
  unit              String          @default("PCS")
  orderedQuantity   Decimal         @db.Decimal(12, 3)
  deliveredQuantity Decimal         @db.Decimal(12, 3)
  sortOrder         Int             @default(0)

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([challanId])
  @@index([productId])
  @@index([salesOrderItemId])
  @@map("delivery_challan_item")
}

model SalesReturn {
  id                    String            @id
  organizationId        String
  organization          Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  returnNumber          String

  customerId            String?
  customer              Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName          String
  customerEmail         String?
  customerAddress       String?
  customerGstin         String?
  customerPlaceOfSupply String?

  invoiceId             String?
  invoice               Invoice?          @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  salesOrderId          String?
  salesOrder            SalesOrder?       @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)

