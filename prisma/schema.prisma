  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_order_item")
}

enum PurchaseBillStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

model PurchaseBill {
  id                      String             @id
  organizationId          String
  organization            Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  billNumber              String

  // Supplier reference & snapshots
  supplierId              String?
  supplier                Supplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  supplierName            String
  supplierEmail           String?
  supplierAddress         String?
  supplierGstin           String?
  supplierPlaceOfSupply   String?

  // Supplier's own invoice reference
  supplierInvoiceNumber   String?
  supplierInvoiceDate     DateTime?

  // Source purchase order (optional linkage, preserved as snapshot)
  purchaseOrderId         String?
  purchaseOrder           PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  purchaseOrderNumber     String?

  // Dates
  billDate                DateTime
  dueDate                 DateTime
  status                  PurchaseBillStatus @default(DRAFT)
  taxMode                 String             @default("CGST_SGST")
  currency                String             @default("INR (₹)")
  paymentTerms            String?

  // Monetary Totals (decimal-safe)
  subtotal                Decimal            @db.Decimal(14, 2)
  lineDiscountTotal       Decimal            @default(0) @db.Decimal(14, 2)
  additionalDiscount      Decimal            @default(0) @db.Decimal(14, 2)
  additionalDiscountType  String             @default("fixed")
  additionalDiscountLabel String?
  additionalCharges       Decimal            @default(0) @db.Decimal(14, 2)
  additionalChargesLabel  String?
  taxableAmount           Decimal            @db.Decimal(14, 2)
  cgst                    Decimal            @default(0) @db.Decimal(14, 2)
  sgst                    Decimal            @default(0) @db.Decimal(14, 2)
  igst                    Decimal            @default(0) @db.Decimal(14, 2)
  totalTax                Decimal            @default(0) @db.Decimal(14, 2)
  total                   Decimal            @db.Decimal(14, 2)

  // Notes & Terms
  notes                   String?
  terms                   String?

  // Timestamps
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  // Line Items
  items                   PurchaseBillItem[]

  // Returns recorded against this bill
  purchaseReturns         PurchaseReturn[]

  // Payment allocations against this bill
  supplierPaymentAllocations SupplierPaymentAllocation[]

  @@unique([organizationId, billNumber])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, billDate])
  @@index([supplierId])
  @@index([purchaseOrderId])
  @@map("purchase_bill")
}

model PurchaseBillItem {
  id                String        @id
  purchaseBillId    String
  purchaseBill      PurchaseBill  @relation(fields: [purchaseBillId], references: [id], onDelete: Cascade)

  productId         String?
  product           Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)

  item              String
  description       String?
  hsnSac            String?
  // Unit snapshot from the product master at selection time.
  unit              String?
  quantity          Decimal       @db.Decimal(12, 3)
  unitPrice         Decimal       @db.Decimal(14, 2)
  discount          Decimal       @default(0) @db.Decimal(5, 2)
  taxRate           Decimal       @default(18) @db.Decimal(5, 2)
  taxableAmount     Decimal       @db.Decimal(14, 2)
  taxAmount         Decimal       @db.Decimal(14, 2)
  lineTotal         Decimal       @db.Decimal(14, 2)
  sortOrder         Int           @default(0)

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  purchaseReturnItems PurchaseReturnItem[]

  @@index([purchaseBillId])
  @@index([productId])
  @@map("purchase_bill_item")
}

enum PurchaseReturnStatus {
  DRAFT
  APPROVED
  COMPLETED
  CANCELLED
}

model PurchaseReturn {
  id                      String               @id
  organizationId          String
  organization            Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  returnNumber            String

  // Supplier reference & snapshots
  supplierId              String?
  supplier                Supplier?            @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  supplierName            String
  supplierEmail           String?
  supplierAddress         String?
  supplierGstin           String?
  supplierPlaceOfSupply   String?

  // Source documents (return against an eligible bill and/or order)
  purchaseBillId          String?
  purchaseBill            PurchaseBill?        @relation(fields: [purchaseBillId], references: [id], onDelete: SetNull)
  purchaseBillNumber      String?
  purchaseOrderId         String?
  purchaseOrder           PurchaseOrder?       @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  purchaseOrderNumber     String?

  // Return details
  returnDate              DateTime
  reason                  String
  status                  PurchaseReturnStatus @default(DRAFT)
  taxMode                 String               @default("CGST_SGST")
  currency                String               @default("INR (₹)")

  // Monetary Totals (decimal-safe, returned-goods value)
  subtotal                Decimal              @db.Decimal(14, 2)
  taxAmount               Decimal              @default(0) @db.Decimal(14, 2)
  totalAmount             Decimal              @default(0) @db.Decimal(14, 2)

  // Notes & Terms
  notes                   String?
  terms                   String?

  // Timestamps
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  // Line Items
  items                   PurchaseReturnItem[]

  @@unique([organizationId, returnNumber])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, returnDate])
  @@index([supplierId])
  @@index([purchaseBillId])
  @@index([purchaseOrderId])
  @@map("purchase_return")
}

model PurchaseReturnItem {
  id                String          @id
  purchaseReturnId  String
  purchaseReturn    PurchaseReturn  @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)

  productId         String?
  product           Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)

  purchaseBillItemId String?
  purchaseBillItem   PurchaseBillItem? @relation(fields: [purchaseBillItemId], references: [id], onDelete: SetNull)

  item              String
  description       String?
  hsnSac            String?
  billedQuantity    Decimal         @db.Decimal(12, 3)
  returnQuantity    Decimal         @db.Decimal(12, 3)
  unitPrice         Decimal         @db.Decimal(14, 2)
  discount          Decimal         @default(0) @db.Decimal(5, 2)
  taxRate           Decimal         @default(18) @db.Decimal(5, 2)
  taxAmount         Decimal         @default(0) @db.Decimal(14, 2)
  lineTotal         Decimal         @default(0) @db.Decimal(14, 2)
  disposition       String          @default("RESTOCK")
  reason            String?
  sortOrder         Int             @default(0)

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([purchaseReturnId])
  @@index([productId])
  @@index([purchaseBillItemId])
  @@map("purchase_return_item")
}

model SupplierPayment {
  id             String        @id
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Supplier reference & snapshot (snapshot survives supplier edits/deletion)
  supplierId     String?
  supplier       Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  supplierName   String

  // Paid amount (must equal the sum of allocations; overpayment rejected)
  amount         Decimal       @db.Decimal(14, 2)
  currency       String        @default("INR (₹)")
  paymentDate    DateTime
  method         PaymentMethod @default(OTHER)
  reference      String?
  notes          String?

  // Lifecycle: reversal is a state transition, never a delete
  status         PaymentStatus @default(ACTIVE)
  reversedAt     DateTime?
  reversalReason String?
  reversedBy     String?

  // Duplicate-submission protection (one form session = one key)
  idempotencyKey String?

  // Audit
  createdBy      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  allocations    SupplierPaymentAllocation[]

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, paymentDate])
  @@index([supplierId])
  @@map("supplier_payment")
}

model SupplierPaymentAllocation {
  id             String          @id
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  paymentId      String
  payment        SupplierPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  purchaseBillId String
  purchaseBill   PurchaseBill    @relation(fields: [purchaseBillId], references: [id], onDelete: Restrict)

  // Cash applied to this bill (immutable once created)
  amount         Decimal         @db.Decimal(14, 2)

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([paymentId, purchaseBillId])
  @@index([organizationId])
  @@index([paymentId])
  @@index([purchaseBillId])
  @@map("supplier_payment_allocation")
}

